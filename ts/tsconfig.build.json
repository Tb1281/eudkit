{
  // Build config: transpile + declarations. Type-checked by tsc.
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "./dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "sourceMap": false
  },
  "exclude": ["./tests", "./dist"],
  "extends": "./tsconfig.json",
  "include": ["./*.ts"]
}
