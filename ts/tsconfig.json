{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "./*.ts",
    "./scripts/**/*.ts",
    "./tests/**/*.ts",
    "../examples/quickstart/ts/*.ts",
    "../examples/ts/*.ts"
  ]
}
